{
  "ignore": ["dist/**", "coverage/**", "apps/userscript/vendor/**"],
  "rules": {
    "find-import-file-without-extension": {
      "disable": ["find-import-file-without-extension", "ast-grep:find-import-file-without-extension"]
    },
    "high-complexity": { "threshold": 75 },
    "high-fan-out": { "threshold": 50 },
    "knip": {
      "disable": ["knip:export", "knip:file", "knip:devDependency"]
    },
    "jscpd": { "disable": ["jscpd:duplicate"] },
    "large-class": { "disable": ["large-class", "ast-grep:large-class"] },
    "high-import-coupling": { "disable": ["high-import-coupling"] },
    "pass-through-wrappers": { "disable": ["pass-through-wrappers"] },
    "console-statement": { "disable": ["console-statement"] },
    "ts-react-antipatterns": { "disable": ["ts-react-antipatterns"] },
    "style-advisories": {
      "disable": [
        "ast-grep:no-unknown-parameters",
        "ast-grep:no-runtime-typeof",
        "ast-grep:no-unsafe-dictionary-unknown",
        "ast-grep:long-parameter-list",
        "ast-grep:no-conditional-empty-object-spread",
        "ast-grep:no-conditional-empty-object-spread-js",
        "ast-grep:no-await-expression-member-js",
        "ast-grep:prefer-dom-node-append",
        "ast-grep:prefer-dom-node-append-js",
        "ast-grep:prefer-query-selector",
        "ast-grep:no-known-value-widening",
        "typescript:80006",
        "typescript:6387"
      ]
    }
  }
}
