{
  "name": "@hv-pony-solver/model-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render-config": "node scripts/render-wrangler-config.mjs",
    "dev": "pnpm render-config && wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/render-wrangler-config.test.mjs scripts/check-deployment-contract.test.mjs",
    "test:coverage": "vitest run --coverage && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 --test-coverage-include=scripts/wrangler-config-renderer.mjs --test-coverage-include=scripts/wrangler-config-guard.mjs --test-coverage-include=scripts/check-deployment-contract.mjs scripts/render-wrangler-config.test.mjs scripts/check-deployment-contract.test.mjs",
    "check:deployment": "node scripts/check-deployment-contract.mjs",
    "deploy": "HV_PONY_SOLVER_RENDER_ENV=deploy pnpm render-config && node scripts/validate-wrangler-config.mjs && wrangler deploy"
  },
  "knip": {
    "ignoreDependencies": [
      "cloudflare"
    ]
  },
  "dependencies": {
    "@hv-pony-solver/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
