{
  "name": "@hv-pony-solver/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:packaged": "node scripts/build-extension.mjs --model-mode packaged",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test:e2e:chromium": "node scripts/chromium-load-smoke.mjs",
    "test:e2e:content": "node scripts/chromium-content-smoke.mjs",
    "test:e2e:firefox": "node scripts/firefox-load-smoke.mjs",
    "test:e2e:packaged:chromium": "node scripts/chromium-packaged-model-smoke.mjs",
    "test:e2e:packaged:firefox": "node scripts/firefox-packaged-model-smoke.mjs",
    "test:e2e:packaged": "pnpm run test:e2e:packaged:chromium && pnpm run test:e2e:packaged:firefox",
    "test": "vitest run && node --test scripts/build-extension.test.mjs",
    "test:coverage": "vitest run --coverage && node --test --experimental-test-coverage --test-coverage-include=scripts/build-extension.mjs scripts/build-extension.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hv-pony-solver/browser-core": "workspace:*",
    "@hv-pony-solver/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "onnxruntime-web": "1.27.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10",
    "web-ext": "10.5.0"
  }
}
